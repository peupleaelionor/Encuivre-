# EN CUIVRE OS — environment variables
# Copy to .env.local for local development. Do NOT commit real secrets.

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Margin Guard thresholds (percent).
NEXT_PUBLIC_MARGIN_TARGET_PERCENT=8
NEXT_PUBLIC_MARGIN_FLOOR_PERCENT=3

# --- Database ---
# When set, the app uses a real PostgreSQL (postgres-js). When UNSET, it falls
# back to PGlite (embedded Postgres) — great for local dev, tests and CI.
# DATABASE_URL="postgresql://user:password@host:5432/encuivre"
#
# PGlite storage location (dev). Use ":memory:" for an ephemeral DB (tests).
# ENCUIVRE_DB_PATH="./data/pg"
#
# Seed a real Postgres with the fictional demo dataset (NEVER in real production):
# ENCUIVRE_SEED="true"

# --- Auth ---
# Required in production (>= 16 chars). Signs the session cookie. Server-only.
# Generate: openssl rand -base64 48
AUTH_SECRET=""

# --- Supabase (OPTIONAL provider) ---
# The domain does NOT depend on Supabase; it is only one possible Postgres/Auth
# provider. If used, set DATABASE_URL above to the Supabase connection string.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role is SERVER-ONLY — never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=""
