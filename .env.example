# EN CUIVRE OS — environment variables
# Copy to .env.local for local development. Do NOT commit real secrets.

# --- Application ---
# Default gross margin floor (in %) below which Margin Guard turns AMBER.
NEXT_PUBLIC_MARGIN_TARGET_PERCENT=8

# Hard floor (in %) below which Margin Guard turns RED (deal cannot be validated).
NEXT_PUBLIC_MARGIN_FLOOR_PERCENT=3

# --- Persistence (DELIBERATE DEBT / V2) ---
# V1 ships with an in-repo typed seed dataset (no external database required).
# When a real database is introduced, configure it here.
# DATABASE_URL="postgresql://user:password@localhost:5432/encuivre"

# --- Auth (DELIBERATE DEBT / V2) ---
# V1 is a single-operator tool without external auth. See docs/risk-controls.md.
# AUTH_SECRET=""
